;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ANTIVIRUS"
config/version="0.1.1"
run/main_scene="uid://csgspsm0lvyvx"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://bvge6615fsd7r"

[autoload]

ScreenTransition="*uid://c0byafj3llwij"

[display]

